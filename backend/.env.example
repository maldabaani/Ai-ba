ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

CHROMA_PERSIST_PATH=./chroma_db
NOTION_API_KEY=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
NOTION_DATABASE_ID=ai-ba
NOTION_PARENT_PAGE_ID=https://app.notion.com/p/c45ed9a6cb4f46a9b59823b0a73198ee?v=f187017a5e9b4e0ea1220a6107402931&source=copy_link

MCP_SERVER_PATH=
ADO_ORGANIZATION=
ADO_PROJECT=

# Notion internal integration token (Settings -> Connections -> Develop or
# manage integrations -> New integration). IMPORTANT: open the target database
# in Notion -> ... menu -> Connections -> add this integration, or page creation
# fails with "Could not find database".
NOTION_API_KEY=
# The database to write Epics into. Either (a) point this at an existing database
# you already use, or (b) run `python -m scripts.setup_notion_database` once to
# create a fresh one and paste the printed ID here.
NOTION_DATABASE_ID=
# Only needed to run scripts/setup_notion_database.py the first time: the ID
# of a Notion page (shared with the integration) to create the database under.
NOTION_PARENT_PAGE_ID=
# Mapping onto the target database's schema. Defaults match a standard sprint
# board: title property "Task" and a status-type property "Status" with a
# "To Do" option. Override if your database uses different names. PPM/system
# metadata is written into the page body, so no extra columns are required.
# Set NOTION_STATUS_PROPERTY= (empty) to skip writing status.
NOTION_TITLE_PROPERTY=Task
NOTION_STATUS_PROPERTY=Status
NOTION_STATUS_VALUE=To Do

CORS_ORIGINS=http://localhost:4200

JOBS_DIR=./jobs
UPLOADS_DIR=./uploads
EXPORTS_DIR=./exports

# "production" (default) or "selftest" — selftest swaps in a prompt variant
# for assessing SDDs about StoryForge AI's own codebase. Leave unset for real use.
PROMPT_VARIANT=production

# "document" (default) writes approved stories to a .docx, downloadable via
# GET /export/document/{job_id}. Set to "ado" to push to Azure DevOps, or
# "notion" to push to a Notion database (see NOTION_* settings above).
OUTPUT_MODE=document
